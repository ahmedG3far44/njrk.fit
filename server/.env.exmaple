PORT=8080
NODE_ENV=production
ALLOWED_ORIGINS=https://yourdomain.com

CLIENT_URL=https://yourdomain.com
API_URL=https://yourdomain.com/api

OPENROUTER_API_KEY=sk-or-v1-<your-new-key>

# Stripe (use LIVE keys in production)
STRIPE_SECRET_KEY=sk_live_<your-stripe-secret>
STRIPE_WEBHOOK_SECRET=whsec_<your-webhook-secret>

# Gmail SMTP — use an App Password
SMTP_USER=njerka.fit@gmail.com
SMTP_PASSWORD=<your-gmail-app-password>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Generate with: openssl rand -base64 48
JWT_SECRET=<random-64-char-string>
JWT_EXPIRATION=3h
JWT_REFRESH_SECRET=<different-random-64-char-string>
JWT_REFRESH_EXPIRATION=7d

# Admin accounts
ADMIN_EMAIL_1=admin@njerka.fit
ADMIN_PASSWORD_1=<strong-password-min-8>
ADMIN_NAME_1=Admin
ADMIN_EMAIL_2=ops2222@gmail.com
ADMIN_PASSWORD_2=<strong-password-min-8>
ADMIN_NAME_2=Admin_2

# Google OAuth (create in Google Cloud Console)
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# Cloudinary (create free account at cloudinary.com)
CLOUDINARY_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# MongoDB with auth
MONGODB_URI=mongodb://njerka:${MONGO_PASSWORD}@mongodb:27017/njrk?authSource=admin

# RapidAPI (for ExerciseDB)
RAPIDAPI_KEY=<your-rapidapi-key>